/* ========== Reset ========== */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

/* ========== Theme ========== */
:root {
    --bg: #eef6ff;
    --bg-elevated: rgba(255, 255, 255, 0.78);
    --card-bg: rgba(255, 255, 255, 0.82);
    --card-border: rgba(148, 163, 184, 0.22);
    --accent: #3b82f6;
    --accent-soft: rgba(59, 130, 246, 0.12);
    --text-main: #0f172a;
    --text-muted: #64748b;
    --danger: #ef4444;
    --radius: 22px;
    --shadow-soft: 0 20px 50px rgba(59, 130, 246, 0.10);
    --font-sans: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
                 sans-serif;
}

/* ========== Base ========== */
body {
    font-family: var(--font-sans);
    background:
        radial-gradient(circle at top left, rgba(191, 219, 254, 0.9) 0%, rgba(191, 219, 254, 0) 35%),
        radial-gradient(circle at top right, rgba(186, 230, 253, 0.85) 0%, rgba(186, 230, 253, 0) 30%),
        linear-gradient(135deg, #f8fbff 0%, #eff6ff 40%, #dbeafe 100%);
    color: var(--text-main);
    min-height: 100vh;
}

.app-shell {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
}

.container {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 20px;
}

/* ========== Header ========== */

.site-header {
    border-bottom: 1px solid rgba(148, 163, 184, 0.18);
    background: rgba(255, 255, 255, 0.55);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    position: sticky;
    top: 0;
    z-index: 10;
}

.header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 14px 0;
}

.brand {
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 0.95rem;
    color: var(--accent);
}

.top-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    justify-content: flex-end;
}

.top-nav a {
    text-decoration: none;
    padding: 8px 12px;
    border-radius: 999px;
    font-size: 0.82rem;
    color: var(--text-muted);
    border: 1px solid transparent;
    transition: background 0.2s, color 0.2s, border-color 0.2s;
}

.top-nav a:hover {
    background: var(--accent-soft);
    color: var(--accent);
}

.top-nav a.active {
    background: rgba(59, 130, 246, 0.14);
    border-color: rgba(59, 130, 246, 0.18);
    color: var(--accent);
}

/* ========== Main Layout ========== */

.main {
    flex: 1;
    padding: 48px 0 56px;
}

.main-layout {
    display: grid;
    grid-template-columns: minmax(320px, 560px) minmax(320px, 500px);
    justify-content: center;
    align-items: start;
    gap: 28px;
}

/* ========== Cards ========== */

.card {
    background: var(--card-bg);
    border-radius: var(--radius);
    border: 1px solid var(--card-border);
    box-shadow: var(--shadow-soft);
    padding: 28px 24px;
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
}

.card-title {
    font-size: 1.35rem;
    margin-bottom: 20px;
    text-align: center;
    color: #0b1220;
}

/* ========== Form ========== */

.sf-form {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px 16px;
    font-size: 0.95rem;
}

.form-row {
    display: flex;
    flex-direction: column;
    gap: 6px;
}

.form-row--full {
    grid-column: 1 / -1;
}

label,
legend {
    font-weight: 600;
    color: #1e293b;
}

input,
select {
    background: rgba(255, 255, 255, 0.92);
    border-radius: 999px;
    border: 1px solid rgba(148, 163, 184, 0.35);
    padding: 11px 14px;
    color: var(--text-main);
    font-size: 0.95rem;
    outline: none;
    transition: border-color 0.18s, box-shadow 0.18s, background 0.18s, transform 0.18s;
}

input::placeholder {
    color: #94a3b8;
}

input:focus,
select:focus {
    border-color: rgba(59, 130, 246, 0.55);
    box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.14);
    background: #ffffff;
}

fieldset {
    border-radius: 18px;
    border: 1px solid rgba(148, 163, 184, 0.24);
    padding: 14px 14px 12px;
    background: rgba(255, 255, 255, 0.48);
}

legend {
    padding: 0 6px;
    font-size: 0.88rem;
    color: var(--text-muted);
}

.checkbox-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-top: 6px;
}

.checkbox-group label {
    font-weight: 500;
    color: #334155;
    font-size: 0.9rem;
    display: flex;
    align-items: center;
}

.checkbox-group input {
    margin-right: 8px;
    transform: translateY(0.5px);
}

/* ========== Form Actions ========== */

.form-actions {
    grid-column: 1 / -1;
    margin-top: 10px;
    display: flex;
    justify-content: center;
}

.btn-primary {
    border: none;
    border-radius: 999px;
    padding: 11px 22px;
    font-size: 0.95rem;
    font-weight: 600;
    cursor: pointer;
    background-image: linear-gradient(135deg, #3b82f6, #60a5fa);
    color: #ffffff;
    box-shadow: 0 14px 28px rgba(59, 130, 246, 0.22);
    transition: transform 0.14s ease-out, box-shadow 0.14s ease-out,
                filter 0.14s ease-out;
}

.btn-primary:hover {
    transform: translateY(-1px);
    box-shadow: 0 18px 34px rgba(59, 130, 246, 0.26);
    filter: brightness(1.03);
}

.btn-primary:active {
    transform: translateY(0);
    box-shadow: 0 10px 18px rgba(59, 130, 246, 0.20);
}

/* ========== Info Card ========== */

.info-card {
    font-size: 0.95rem;
}

.info-message h2 {
    font-size: 1.12rem;
    margin-bottom: 6px;
    color: #0f172a;
}

.info-message p {
    color: var(--text-muted);
}

.results-placeholder {
    margin-top: 10px;
}

.results-placeholder h3 {
    font-size: 1rem;
    margin-bottom: 6px;
    color: #0f172a;
}

.results-placeholder p {
    color: #475569;
    margin-bottom: 6px;
}

.results-placeholder ul {
    margin-left: 18px;
    color: #475569;
}

.results-placeholder li + li {
    margin-top: 3px;
}

.footer-links {
    margin-top: 10px;
}

.footer-links p {
    margin-bottom: 2px;
}

.footer-links .muted {
    color: var(--text-muted);
    font-size: 0.85rem;
}

.divider {
    border: none;
    border-top: 1px dashed rgba(148, 163, 184, 0.35);
    margin: 16px 0;
}

/* ========== Charts ========== */

canvas {
    width: 100% !important;
    max-width: 100%;
    background: rgba(255, 255, 255, 0.55);
    border: 1px solid rgba(148, 163, 184, 0.16);
    border-radius: 18px;
    padding: 10px;
}

/* ========== Footer ========== */

.site-footer {
    border-top: 1px solid rgba(148, 163, 184, 0.16);
    padding: 16px 0 20px;
    font-size: 0.82rem;
    color: var(--text-muted);
    text-align: center;
    background: rgba(255, 255, 255, 0.45);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
}

/* ========== Responsive ========== */

@media (max-width: 860px) {
    .main-layout {
        grid-template-columns: 1fr;
    }

    .card-title {
        text-align: left;
    }
}

@media (max-width: 700px) {
    .header-inner {
        flex-direction: column;
        align-items: flex-start;
    }

    .top-nav {
        justify-content: flex-start;
    }

    .sf-form {
        grid-template-columns: 1fr;
    }

    .card {
        padding: 22px 18px;
    }

    input,
    select {
        padding: 10px 12px;
    }
}